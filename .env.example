# Database Configuration
# Copy this file to .env and adjust values for your local environment
# DO NOT commit the .env file to Git!

# For MAMP users (macOS):
DB_HOST=127.0.0.1
DB_PORT=8889
DB_NAME=job
DB_USER=root
DB_PASS=root
DB_CHARSET=utf8mb4

# For XAMPP/WAMP users (Windows) - uncomment and modify:
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=job
# DB_USER=root
# DB_PASS=
# DB_CHARSET=utf8mb4

# For MySQL standard installation - uncomment and modify:
# DB_HOST=localhost  
# DB_PORT=3306
# DB_USER=root
# DB_PASS=